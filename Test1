    };

    /* ============ FIX DATA RENDER ============ */
    function showFix(key) {
      const fix = FIXES[key];
      if (!fix) return;

      document.getElementById('fix-outcome').textContent = fix.outcome;

      const stage = fix.triptychMode
        ? fix.illustration
        : `<div class="illustration-stage"><span class="gif-tag">${fix.gifLabel}</span>${fix.illustration}</div>`;

      const checklistHtml = `<ul class="checklist">${fix.checklist.map(c => `<li>${c}</li>`).join('')}</ul>`;

      document.getElementById('fix-card').innerHTML = `
        ${stage}
        <div class="instruction-body">
          <h3>${fix.title}</h3>
          <p>${fix.intro}</p>
          ${checklistHtml}
        </div>
      `;

      const didntWork = document.getElementById('btn-didnt-work');
      if (fix.nextFix) {
        didntWork.style.display = '';
        didntWork.dataset.next = fix.nextFix;
        didntWork.textContent = "Didn't work →";
      } else {
        didntWork.style.display = 'none';
      }

      showScreen('fix');
    }

    /* ============ BUILD FLOW ============ */
    let buildState = { planeId: 'p11', stepIndex: 0 };

    // ============= OWNERSHIP / IAP STATE =============
    // Each plane is either free (always unlocked) or paid (unlocks via IAP).
    // For the mockup, ownership lives in memory only — in the real app this
    // would be backed by StoreKit (iOS) / Play Billing (Android) entitlements
    // and synced across the user's account.
    const PLANE_PRICES = {
      'p11': null,      // Always free
      'p12': '$1.99',
      'p13': '$1.99',
      'p14': '$1.99',
      'p15': '$1.99',
      'p16': '$1.99'
    };
    const BUNDLE_PRICE = '$6.99';

    let owned = new Set(['p11']);  // P11 is always owned at app open
    let p11Completed = false;       // For the post-P11 upsell

    function isOwned(id) { return owned.has(id); }

    // Pending purchase target — what we'll grant if the user confirms in the
    // purchase sheet. Either a plane id like 'p12' or 'bundle'.
    let pendingPurchase = null;

    function renderPlaneList() {
      const planes = [
        { id: 'p11', tag: 'P11', name: 'The P11', desc: 'Most forgiving — recommended first.' },
        { id: 'p12', tag: 'P12', name: 'The P12', desc: 'A sleeker variation with a different fuselage.' },
        { id: 'p13', tag: 'P13', name: 'The P13', desc: 'Inverted "M" fuselage, longer body.' },
        { id: 'p14', tag: 'P14', name: 'The P14', desc: 'A different challenge.' },
        { id: 'p15', tag: 'P15', name: 'The P15', desc: 'Stabilized by the M-fuselage itself.' },
        { id: 'p16', tag: 'P16', name: 'The P16', desc: 'For experienced builders.' }
      ];

      document.getElementById('plane-list').innerHTML = planes.map(p => {
        const unlocked = isOwned(p.id);
        const lockedClass = unlocked ? '' : 'locked';
        const trailing = unlocked
          ? '<span class="plane-row-arrow">→</span>'
          : `<span class="plane-row-lock"><span class="plane-row-lock-icon">🔒</span>${PLANE_PRICES[p.id]}</span>`;
        return `
          <button class="plane-row ${lockedClass}" data-plane="${p.id}">
            <span class="plane-row-tag">${p.tag}</span>
            <span class="plane-row-text">
              <h3>${p.name}</h3>
              <p>${p.desc}</p>
            </span>
            ${trailing}
          </button>
        `;
      }).join('');

      document.querySelectorAll('.plane-row[data-plane]').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.plane;
          if (isOwned(id)) {
            startBuild(id);
          } else {
            showUnlockScreen(id);
          }
        });
      });

      // Show or hide the bundle teaser depending on remaining locked planes
      const lockedCount = planes.filter(p => !isOwned(p.id)).length;
      const teaser = document.getElementById('bundle-teaser');
      if (lockedCount >= 2) {
        teaser.hidden = false;
      } else {
        teaser.hidden = true;
      }
    }

    // ============= UNLOCK / PURCHASE FLOW =============

    const PLANE_META = {
      'p12': { name: 'The P12', tag: 'P12', desc: 'A sleeker variation with a different fuselage.' },
      'p13': { name: 'The P13', tag: 'P13', desc: 'Inverted "M" fuselage, longer body.' },
      'p14': { name: 'The P14', tag: 'P14', desc: 'A different challenge.' },
      'p15': { name: 'The P15', tag: 'P15', desc: 'Stabilized by the M-fuselage itself.' },
      'p16': { name: 'The P16', tag: 'P16', desc: 'For experienced builders.' }
    };

    function showUnlockScreen(planeId) {
      const meta = PLANE_META[planeId];
      if (!meta) return;
      pendingPurchase = planeId;
      document.getElementById('unlock-tag').textContent = meta.tag;
      document.getElementById('unlock-name').textContent = meta.name;
      document.getElementById('unlock-desc').textContent = meta.desc;
      document.getElementById('unlock-price').textContent = PLANE_PRICES[planeId];
      // Update step count for the right plane
      const stepCount = (PLANES[planeId] && PLANES[planeId].steps) ? PLANES[planeId].steps.length : 22;
      document.querySelectorAll('[data-step-count]').forEach(el => el.textContent = stepCount);
      showScreen('unlock');
    }

    function showBundleScreen() {
      pendingPurchase = 'bundle';
      // Build the bundle grid (only locked planes)
      const lockedTags = Object.keys(PLANE_META).filter(id => !isOwned(id))
        .map(id => PLANE_META[id].tag);
      document.getElementById('bundle-grid').innerHTML = lockedTags
        .map(tag => `<div class="bundle-grid-item">${tag}</div>`).join('');

      // Update count + saving math depending on how many are still locked
      const n = lockedTags.length;
      const indivPrice = 1.99;
      const bundlePrice = 6.99;
      const indivTotal = (n * indivPrice).toFixed(2);
      const savings = (n * indivPrice - bundlePrice).toFixed(2);

      // Set the button label & summary lines
      const buyBtn = document.getElementById('btn-buy-bundle');
      buyBtn.querySelector('span:first-child').textContent =
        n === Object.keys(PLANE_META).length ? 'Unlock all 5' : `Unlock all ${n}`;

      // Update summary section
      const summary = document.querySelector('.bundle-summary');
      summary.innerHTML = `
        <div class="bundle-line">
          <span>${n} plane design${n === 1 ? '' : 's'} at $1.99 each</span>
          <span class="strike">$${indivTotal}</span>
        </div>
        <div class="bundle-line bundle-total">
          <span>Bundle price</span>
          <span class="bundle-total-price">$${bundlePrice.toFixed(2)}</span>
        </div>
        <div class="bundle-saves">You save $${savings}</div>
      `;

      showScreen('bundle');
    }

    function openPurchaseSheet() {
      if (!pendingPurchase) return;
      let item, amount;
      if (pendingPurchase === 'bundle') {
        item = 'All Designs Bundle';
        amount = BUNDLE_PRICE;
      } else {
        item = `${PLANE_META[pendingPurchase].tag} design`;
        amount = PLANE_PRICES[pendingPurchase];
      }
      document.getElementById('purchase-item').textContent = item;
      document.getElementById('purchase-amount').textContent = amount;
      document.getElementById('purchase-overlay').hidden = false;
    }

    function closePurchaseSheet() {
      document.getElementById('purchase-overlay').hidden = true;
    }

    function completePurchase() {
      if (!pendingPurchase) {
        closePurchaseSheet();
        return;
      }
      let unlockedId;
      if (pendingPurchase === 'bundle') {
        // Unlock everything
        Object.keys(PLANE_META).forEach(id => owned.add(id));
        unlockedId = 'bundle';
      } else {
        owned.add(pendingPurchase);
        unlockedId = pendingPurchase;
      }
      closePurchaseSheet();
      showSuccessScreen(unlockedId);
      // Refresh the plane list so the next time they visit, the lock is gone
      renderPlaneList();
    }

    function showSuccessScreen(unlockedId) {
      if (unlockedId === 'bundle') {
        document.getElementById('success-title').textContent = 'You unlocked all 5 designs.';
        document.getElementById('success-sub').textContent = 'Pick one to build first.';
        document.getElementById('success-build-title').textContent = 'Pick a design';
        document.getElementById('success-build-sub').textContent = 'You now have access to every plane.';
        document.getElementById('btn-success-build').onclick = () => showScreen('build');
      } else {
        const meta = PLANE_META[unlockedId];
        const stepCount = (PLANES[unlockedId] && PLANES[unlockedId].steps) ? PLANES[unlockedId].steps.length : 22;
        document.getElementById('success-title').textContent = `You unlocked ${meta.name}.`;
        document.getElementById('success-sub').textContent = 'Ready to build it?';
        document.getElementById('success-build-title').textContent = `Start building the ${meta.tag}`;
        document.getElementById('success-build-sub').textContent = `${stepCount} steps, with the original book figures.`;
        document.getElementById('btn-success-build').onclick = () => startBuild(unlockedId);
      }
      pendingPurchase = null;
      showScreen('unlock-success');
    }

    function startBuild(planeId) {
      buildState = { planeId, stepIndex: 0 };
      renderStep();
      showScreen('step');
    }

    function renderStep() {
      const plane = PLANES[buildState.planeId];
      if (!plane) return;
      const total = plane.steps.length;
      const i = buildState.stepIndex;

      // If they've gone past the last step, show the build-done screen.
      if (i >= total) {
        // Mark P11 completion for the post-P11 upsell
        if (buildState.planeId === 'p11') {
          p11Completed = true;
        }
        showScreen('build-done');
        return;
      }

      const step = plane.steps[i];
      document.getElementById('step-plane-name').textContent = plane.name;
      document.getElementById('step-current').textContent = i + 1;
      document.getElementById('step-total').textContent = total;
      document.getElementById('progress-bar').style.width = `${((i + 1) / total) * 100}%`;

      // Build the figure stage. If there's a secondary figure (e.g. step 7
      // includes both Figure 7 and Figure 7b), show them side-by-side.
      const primaryFig = `
        <figure class="step-figure">
          <img src="${step.figure}" alt="${step.figLabel}" loading="lazy">
          <figcaption>${step.figLabel}</figcaption>
        </figure>`;
      const secondaryFig = step.secondaryFigure ? `
        <figure class="step-figure">
          <img src="${step.secondaryFigure}" alt="${step.secondaryFigLabel}" loading="lazy">
          <figcaption>${step.secondaryFigLabel}</figcaption>
        </figure>` : '';
      const stage = `<div class="figure-stage${step.secondaryFigure ? ' two-up' : ''}">${primaryFig}${secondaryFig}</div>`;

      const tipHtml = step.tip ? `<div class="tip"><strong>Heads up</strong>${step.tip}</div>` : '';

      document.getElementById('step-card').innerHTML = `
        ${stage}
        <div class="step-card-body">
          <h3>${step.title}</h3>
          <p>${step.body}</p>
          ${tipHtml}
        </div>
      `;

      // Wire prev/next button states.
      const prev = document.getElementById('btn-step-prev');
      prev.disabled = i === 0;
      prev.style.opacity = i === 0 ? 0.4 : 1;
      prev.style.cursor = i === 0 ? 'not-allowed' : 'pointer';

      const next = document.getElementById('btn-step-next');
      next.textContent = i === total - 1 ? "Done — let's fly →" : 'Next step →';
    }

    /* ============ SCREEN NAVIGATION ============ */
    const SCREENS = [
      'home', 'build', 'step', 'build-done', 'finetune', 'fix',
      'unlock', 'bundle', 'unlock-success'
    ];

    function showScreen(name) {
      SCREENS.forEach(s => {
        const el = document.getElementById(`screen-${s}`);
        if (el) el.setAttribute('hidden', '');
      });
      document.getElementById(`screen-${name}`).removeAttribute('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });

      // When entering build screen, refresh the plane list (in case ownership
      // changed since last visit). When entering build-done, decide whether
      // to show the post-P11 upsell.
      if (name === 'build') {
        renderPlaneList();
      } else if (name === 'build-done') {
        updateUpsellVisibility();
      }
    }

    function updateUpsellVisibility() {
      const card = document.getElementById('upsell-card');
      if (!card) return;
      // Show only if P11 was just completed AND there's still at least one
      // locked plane the user could buy.
      const hasLockedPlane = Object.keys(PLANE_META).some(id => !isOwned(id));
      if (p11Completed && hasLockedPlane) {
        card.hidden = false;
      } else {
        card.hidden = true;
      }
    }

    /* ============ EVENT WIRING ============ */
    // Mode picker on home screen
    document.querySelectorAll('.mode-card[data-mode]').forEach(btn => {
      btn.addEventListener('click', () => {
        const mode = btn.dataset.mode;
        if (mode === 'build') showScreen('build');
        else if (mode === 'finetune') showScreen('finetune');
      });
    });

    // Generic data-nav buttons (back arrows, post-build cards).
    // Special-case 'bundle' since it needs the bundle-grid populated.
    document.querySelectorAll('[data-nav]').forEach(el => {
      el.addEventListener('click', () => {
        const target = el.dataset.nav;
        if (target === 'bundle') {
          showBundleScreen();
        } else {
          showScreen(target);
        }
      });
    });

    // Fine-tune compass
    document.querySelectorAll('.compass button[data-fix]').forEach(btn => {
      btn.addEventListener('click', () => showFix(btn.dataset.fix));
    });
    document.getElementById('btn-throw-again').addEventListener('click', () => showScreen('finetune'));
    document.getElementById('btn-didnt-work').addEventListener('click', e => {
      const next = e.currentTarget.dataset.next;
      if (next) showFix(next);
    });
    document.getElementById('link-preflight').addEventListener('click', () => showFix('preflight'));

    // Build step navigation
    document.getElementById('btn-step-prev').addEventListener('click', () => {
      if (buildState.stepIndex > 0) {
        buildState.stepIndex -= 1;
        renderStep();
      }
    });
    document.getElementById('btn-step-next').addEventListener('click', () => {
      buildState.stepIndex += 1;
      renderStep();
    });

    // Store buttons
    document.getElementById('bundle-teaser').addEventListener('click', showBundleScreen);
    document.getElementById('btn-buy-single').addEventListener('click', openPurchaseSheet);
    document.getElementById('btn-show-bundle').addEventListener('click', showBundleScreen);
    document.getElementById('btn-buy-bundle').addEventListener('click', openPurchaseSheet);
    document.getElementById('purchase-pay').addEventListener('click', completePurchase);
    document.getElementById('purchase-cancel').addEventListener('click', closePurchaseSheet);

    // Initial render
    renderPlaneList();
  </script>


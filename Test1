<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Paper Pilot — Fine-Tuning Field Guide</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    /* Paper & ink — pulled from AFS Paper Airplanes book */
    --paper: #ffffff;
    --ink: #1a1a1a;
    --ink-soft: #4a4a4a;
    --pencil: #8a8a8a;
    /* Book's signature plane palette */
    --navy: #1d3754;
    --powder: #cfe2f3;
    --powder-soft: #e6eff8;
    /* Book's accent red (used for headers, section markers) */
    --red: #a11d2c;
    --red-soft: #fbeaec;
    /* Book's fine-tuning chart orange (used for direction arrows) */
    --orange: #f08020;
    --orange-soft: #fde2cc;
    /* Cobalt link blue (used in book for cross-references) */
    --link: #1d148b;
    --line: rgba(29, 55, 84, 0.18);
    --shadow: 0 2px 0 rgba(29,55,84,0.06), 0 8px 22px -10px rgba(29,55,84,0.18);
    --shadow-lift: 0 4px 0 rgba(29,55,84,0.10), 0 14px 30px -8px rgba(29,55,84,0.24);
  }

- { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }

body {
font-family: ‘Nunito’, system-ui, sans-serif;
background-color: var(–paper);
color: var(–ink);
background-image:
radial-gradient(circle at 15% 10%, rgba(232, 85, 43, 0.06) 0%, transparent 45%),
radial-gradient(circle at 85% 85%, rgba(77, 139, 191, 0.07) 0%, transparent 45%),
url(“data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.5 0 0 0 0 0.4 0 0 0 0 0.3 0 0 0 0.05 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>”);
min-height: 100vh;
line-height: 1.5;
-webkit-font-smoothing: antialiased;
}

.app {
max-width: 540px;
margin: 0 auto;
padding: 28px 22px 80px;
}

/* ———— HEADER ———— */
.brand {
display: flex;
align-items: baseline;
justify-content: space-between;
margin-bottom: 36px;
padding-bottom: 18px;
border-bottom: 1.5px dashed var(–line);
}
.brand .logo {
font-family: ‘Caveat’, cursive;
font-size: 36px;
font-weight: 700;
margin: 0;
letter-spacing: -0.5px;
line-height: 1;
}
.brand .logo .accent { color: var(–orange); }
.brand .tagline {
font-size: 11px;
text-transform: uppercase;
letter-spacing: 1.6px;
color: var(–pencil);
font-weight: 800;
margin: 0;
}

/* ———— SCREEN TRANSITIONS ———— */
.screen { animation: fadeIn 0.28s ease-out; }
.screen[hidden] { display: none; }
@keyframes fadeIn {
from { opacity: 0; transform: translateY(6px); }
to   { opacity: 1; transform: translateY(0); }
}

/* ———— HOME ———— */
.prompt-eyebrow {
font-size: 11px;
text-transform: uppercase;
letter-spacing: 1.6px;
color: var(–orange);
font-weight: 800;
margin: 0;
}
.prompt h1 {
font-family: ‘Caveat’, cursive;
font-size: 48px;
line-height: 1.0;
margin: 8px 0 10px;
font-weight: 700;
}
.prompt p {
color: var(–ink-soft);
margin: 0 0 28px;
font-size: 16px;
}

.compass {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 10px;
margin-bottom: 32px;
}
.compass button {
appearance: none;
border: 1.5px solid var(–ink);
background: white;
color: var(–ink);
border-radius: 14px;
padding: 16px 6px 12px;
font-family: ‘Nunito’, sans-serif;
font-weight: 700;
font-size: 13.5px;
line-height: 1.15;
cursor: pointer;
text-align: center;
box-shadow: var(–shadow);
transition: transform .12s ease, box-shadow .12s ease, background .12s ease;
display: flex;
flex-direction: column;
align-items: center;
gap: 6px;
min-height: 92px;
}
.compass button:hover {
transform: translate(-1px, -2px);
box-shadow: var(–shadow-lift);
background: var(–orange-soft);
}
.compass button:active {
transform: translate(0, 0);
box-shadow: 0 1px 0 rgba(31,36,51,0.06);
}
.compass button .arrow {
font-size: 24px;
line-height: 1;
color: var(–orange);
font-weight: 800;
}
.compass .center {
border: 1.5px dashed var(–line);
background: transparent;
box-shadow: none;
cursor: default;
color: var(–pencil);
font-family: ‘Caveat’, cursive;
font-size: 22px;
font-weight: 600;
display: flex;
align-items: center;
justify-content: center;
line-height: 1;
}
.compass .center svg {
width: 38px;
height: 38px;
}

.footnote {
text-align: center;
font-size: 13.5px;
color: var(–pencil);
margin: 20px 0 0;
}
.footnote a {
color: var(–ink-soft);
text-decoration: underline;
text-decoration-style: dashed;
text-underline-offset: 4px;
cursor: pointer;
font-weight: 700;
}
.footnote a:hover { color: var(–orange); }

/* ———— FIX SCREEN ———— */
.back-btn {
appearance: none;
background: none;
border: none;
color: var(–ink-soft);
font-family: ‘Nunito’, sans-serif;
font-weight: 700;
font-size: 14px;
cursor: pointer;
padding: 0;
margin-bottom: 18px;
}
.back-btn:hover { color: var(–orange); }

.diagnosis { margin-bottom: 18px; }
.diagnosis .eyebrow {
font-size: 11px;
text-transform: uppercase;
letter-spacing: 1.6px;
color: var(–pencil);
font-weight: 800;
margin: 0 0 4px;
}
.diagnosis h2 {
font-family: ‘Caveat’, cursive;
font-size: 40px;
margin: 0;
line-height: 1.05;
}
.diagnosis .outcome { color: var(–orange); }

.instruction-card {
background: white;
border: 1.5px solid var(–ink);
border-radius: 18px;
padding: 0;
overflow: hidden;
box-shadow: var(–shadow);
margin-bottom: 22px;
}
.illustration-stage {
background: var(–paper);
border-bottom: 1.5px dashed var(–line);
aspect-ratio: 16 / 10;
display: flex;
align-items: center;
justify-content: center;
position: relative;
}
.illustration-stage .gif-tag,
.triptych .gif-tag {
position: absolute;
top: 10px;
left: 12px;
font-size: 9.5px;
text-transform: uppercase;
letter-spacing: 1.2px;
color: var(–pencil);
font-weight: 800;
background: white;
padding: 4px 8px;
border-radius: 999px;
border: 1px solid var(–line);
z-index: 2;
}
.illustration-stage svg { max-width: 88%; max-height: 88%; }

/* Figure stage — for build steps where the illustration is a real
image extracted from the PDF rather than an animated SVG. */
.figure-stage {
background: var(–paper);
border-bottom: 1.5px dashed var(–line);
padding: 22px 18px 16px;
display: flex;
align-items: center;
justify-content: center;
min-height: 180px;
}
.figure-stage.two-up {
gap: 18px;
flex-wrap: wrap;
}
.step-figure {
margin: 0;
display: flex;
flex-direction: column;
align-items: center;
gap: 8px;
flex: 1 1 200px;
max-width: 100%;
min-width: 0;
}
.step-figure img {
max-width: 100%;
/* Cap visual height so portrait figures don’t dominate the
phone screen. Aspect ratio is preserved by ‘height: auto’
combined with this max constraint. */
max-height: 440px;
width: auto;
height: auto;
display: block;
object-fit: contain;
}
.figure-stage.two-up .step-figure img {
max-height: 280px;
}
.step-figure figcaption {
font-size: 11px;
text-transform: uppercase;
letter-spacing: 1.4px;
color: var(–pencil);
font-weight: 800;
}

.instruction-body { padding: 22px 24px 24px; }
.instruction-body h3 {
font-family: ‘Nunito’, sans-serif;
font-size: 21px;
font-weight: 800;
margin: 0 0 8px;
color: var(–ink);
letter-spacing: -0.2px;
}
.instruction-body p { margin: 0 0 12px; color: var(–ink-soft); font-size: 15px; }
.instruction-body p:last-child { margin-bottom: 0; }

.checklist {
list-style: none;
padding: 0;
margin: 14px 0 0;
}
.checklist li {
padding: 10px 0 10px 32px;
position: relative;
color: var(–ink);
border-top: 1px dashed var(–line);
font-size: 15px;
line-height: 1.4;
}
.checklist li:before {
content: ‘’;
position: absolute;
left: 6px;
top: 13px;
width: 16px;
height: 16px;
border: 1.5px solid var(–orange);
border-radius: 4px;
background: var(–orange-soft);
}

/* ———— ACTIONS ———— */
.actions {
display: flex;
gap: 10px;
}
.btn {
appearance: none;
border: 1.5px solid var(–ink);
background: white;
font-family: ‘Nunito’, sans-serif;
font-weight: 800;
font-size: 15px;
padding: 14px 16px;
border-radius: 14px;
cursor: pointer;
flex: 1;
box-shadow: var(–shadow);
transition: transform .12s, box-shadow .12s, background .12s;
color: var(–ink);
}
.btn:hover {
transform: translate(-1px, -2px);
box-shadow: var(–shadow-lift);
}
.btn:active {
transform: translate(0, 0);
box-shadow: 0 1px 0 rgba(31,36,51,0.06);
}
.btn.primary {
background: var(–orange);
color: white;
}
.btn.primary:hover { background: #d44a23; }

/* ———— TRIPTYCH (3-step diving fix) ———— */
.triptych {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 0;
background: var(–paper);
border-bottom: 1.5px dashed var(–line);
aspect-ratio: 16 / 8;
position: relative;
}
.triptych > .panel {
display: flex;
align-items: center;
justify-content: center;
border-right: 1.5px dashed var(–line);
position: relative;
padding: 18px 8px 8px;
}
.triptych > .panel:last-child { border-right: none; }
.triptych svg { max-width: 92%; max-height: 92%; }
.triptych .step-num {
position: absolute;
top: 6px;
left: 10px;
font-family: ‘Caveat’, cursive;
font-size: 24px;
color: var(–orange);
font-weight: 700;
line-height: 1;
}
.triptych .step-label {
position: absolute;
bottom: 6px;
left: 0; right: 0;
text-align: center;
font-family: ‘Caveat’, cursive;
font-size: 16px;
color: var(–ink-soft);
line-height: 1;
}

/* ———— ILLUSTRATION DEFAULTS ———— */
/* Match the book’s plane illustration style: navy outlines,
powder-blue paper fills, dashed center lines. */
.illus path,
.illus line,
.illus polygon,
.illus rect,
.illus circle {
stroke: var(–navy);
stroke-width: 1.6;
stroke-linecap: round;
stroke-linejoin: round;
fill: var(–powder);
}
.illus .nofill { fill: none; }
.illus .dashed { stroke-dasharray: 3 4; stroke-width: 1.2; opacity: 0.7; fill: none; }
/* The “accent” class marks the part actively being adjusted —
orange to match the book’s fine-tuning chart direction arrows. */
.illus .accent {
stroke: var(–orange);
fill: var(–orange-soft);
stroke-width: 2;
}
.illus .accent-line { stroke: var(–orange); fill: none; stroke-width: 2; }
.illus text {
fill: var(–ink-soft);
stroke: none;
font-family: ‘Caveat’, cursive;
font-weight: 600;
}

/* ———— ANIMATIONS ———— */
@keyframes flapDown {
0%, 15% { transform: rotate(-32deg); }   /* up position */
55%, 70% { transform: rotate(30deg); }   /* pushed down */
100% { transform: rotate(-32deg); }
}
@keyframes flapUp {
0%, 12% { transform: rotate(0deg); }
50%, 62% { transform: rotate(22deg); }
100% { transform: rotate(0deg); }
}
@keyframes pocketShrink {
0%, 12% { transform: scaleY(1); }
50%, 62% { transform: scaleY(0.42); }
100% { transform: scaleY(1); }
}
@keyframes pocketGrow {
0%, 12% { transform: scaleY(0.55); }
50%, 62% { transform: scaleY(1.15); }
100% { transform: scaleY(0.55); }
}
@keyframes tailStraighten {
0%, 12% { transform: rotate(var(–bend, -22deg)); }
50%, 62% { transform: rotate(0deg); }
100% { transform: rotate(var(–bend, -22deg)); }
}
@keyframes clipSlide {
0%, 12% { transform: translateX(-14px); }
50%, 100% { transform: translateX(0); }
}
@keyframes pulseRing {
0%, 100% { opacity: 0; transform: scale(0.8); }
40% { opacity: 0.7; transform: scale(1.05); }
80% { opacity: 0; transform: scale(1.4); }
}
.pulse { animation: pulseRing 2.4s ease-in-out infinite; transform-origin: center; transform-box: fill-box; }

/* small plane SVG in compass center */
.center-plane path { stroke: var(–pencil); fill: none; stroke-width: 1.5; }

/* ———— MODE CARDS (home screen) ———— */
.mode-cards {
display: flex;
flex-direction: column;
gap: 14px;
margin-bottom: 28px;
}
.mode-card {
appearance: none;
background: white;
border: 1.5px solid var(–ink);
border-radius: 18px;
padding: 18px 18px 18px 18px;
display: grid;
grid-template-columns: 110px 1fr auto;
align-items: center;
gap: 14px;
cursor: pointer;
box-shadow: var(–shadow);
transition: transform .12s, box-shadow .12s, background .12s;
text-align: left;
font-family: ‘Nunito’, sans-serif;
color: var(–ink);
}
.mode-card:hover {
transform: translate(-1px, -2px);
box-shadow: var(–shadow-lift);
background: var(–orange-soft);
}
.mode-card-art {
background: var(–paper);
border: 1.5px dashed var(–line);
border-radius: 12px;
width: 110px;
height: 76px;
display: flex;
align-items: center;
justify-content: center;
overflow: hidden;
}
.mode-card-art svg { max-width: 96%; max-height: 96%; }
.mode-card-text h3 {
margin: 0 0 4px;
font-size: 19px;
font-weight: 800;
letter-spacing: -0.2px;
}
.mode-card-text p {
margin: 0;
font-size: 13.5px;
color: var(–ink-soft);
line-height: 1.35;
}
.mode-card-arrow {
font-size: 22px;
color: var(–orange);
font-weight: 800;
align-self: center;
}

/* ———— PLANE LIST ———— */
.plane-list {
display: flex;
flex-direction: column;
gap: 10px;
}
.plane-row {
appearance: none;
background: white;
border: 1.5px solid var(–ink);
border-radius: 14px;
padding: 14px 16px;
display: grid;
grid-template-columns: auto 1fr auto;
align-items: center;
gap: 14px;
cursor: pointer;
box-shadow: var(–shadow);
text-align: left;
font-family: ‘Nunito’, sans-serif;
color: var(–ink);
transition: transform .12s, box-shadow .12s, background .12s;
}
.plane-row:hover:not([disabled]) {
transform: translate(-1px, -2px);
box-shadow: var(–shadow-lift);
background: var(–orange-soft);
}
.plane-row[disabled] {
opacity: 0.55;
cursor: not-allowed;
background: var(–powder-soft);
}
.plane-row-tag {
font-family: ‘Caveat’, cursive;
font-size: 28px;
color: var(–orange);
font-weight: 700;
line-height: 1;
min-width: 44px;
text-align: center;
}
.plane-row-text h3 {
margin: 0 0 2px;
font-size: 16px;
font-weight: 800;
}
.plane-row-text p {
margin: 0;
font-size: 12.5px;
color: var(–ink-soft);
}
.plane-row-arrow { color: var(–orange); font-weight: 800; }
.plane-row-soon {
font-size: 10px;
text-transform: uppercase;
letter-spacing: 1.4px;
background: var(–line);
color: var(–ink-soft);
padding: 3px 7px;
border-radius: 999px;
font-weight: 800;
}
/* Locked plane: lock icon and price tag */
.plane-row.locked .plane-row-tag {
color: var(–pencil);
}
.plane-row.locked h3 {
color: var(–ink-soft);
}
.plane-row-lock {
display: inline-flex;
align-items: center;
gap: 6px;
font-size: 13px;
font-weight: 800;
color: var(–navy);
background: var(–powder);
padding: 5px 10px;
border-radius: 999px;
}
.plane-row-lock-icon {
font-size: 11px;
opacity: 0.7;
}

/* —– BUNDLE TEASER on plane list —– */
.bundle-teaser {
width: 100%;
margin-top: 14px;
padding: 14px 16px;
background: linear-gradient(135deg, var(–navy), #2c4f73);
color: white;
border: none;
border-radius: 14px;
display: flex;
align-items: center;
gap: 10px;
cursor: pointer;
font-family: inherit;
text-align: left;
}
.bundle-teaser[hidden] { display: none !important; }
.bundle-eyebrow {
font-size: 9px;
text-transform: uppercase;
letter-spacing: 1.6px;
background: var(–orange);
padding: 3px 7px;
border-radius: 999px;
font-weight: 800;
color: var(–ink);
}
.bundle-title {
flex: 1;
font-weight: 700;
font-size: 15px;
}
.bundle-price {
font-weight: 800;
font-size: 16px;
}
.bundle-arrow {
font-weight: 800;
opacity: 0.7;
}

/* —– UNLOCK SCREEN —– */
.unlock-card {
background: white;
border: 1.5px solid var(–line);
border-radius: 18px;
padding: 0;
overflow: hidden;
margin-bottom: 18px;
}
.unlock-preview {
background: linear-gradient(135deg, var(–paper-warm), var(–powder));
padding: 36px 20px;
display: flex;
align-items: center;
justify-content: center;
border-bottom: 1.5px solid var(–line);
}
.unlock-tag {
font-family: ‘EB Garamond’, serif;
font-style: italic;
font-weight: 800;
font-size: 56px;
color: var(–orange);
}
.unlock-info {
padding: 18px 20px 22px;
}
.unlock-info h2 {
margin: 0 0 4px 0;
font-family: ‘EB Garamond’, serif;
font-size: 26px;
}
.unlock-info > p {
color: var(–ink-soft);
margin: 0 0 14px;
}
.unlock-features {
list-style: none;
padding: 0;
margin: 0;
display: flex;
flex-direction: column;
gap: 8px;
}
.unlock-features li {
font-size: 14px;
display: flex;
gap: 10px;
align-items: flex-start;
color: var(–ink);
}
.unlock-features .check {
color: var(–orange);
font-weight: 800;
flex-shrink: 0;
}
.unlock-actions {
display: flex;
flex-direction: column;
gap: 8px;
}
.unlock-buy {
display: flex !important;
align-items: center;
justify-content: center;
gap: 10px;
padding: 14px 18px !important;
font-size: 16px;
}
.unlock-price {
background: rgba(255, 255, 255, 0.22);
padding: 3px 10px;
border-radius: 999px;
font-weight: 800;
font-size: 14px;
}
.unlock-bundle-link {
background: transparent !important;
border: none !important;
color: var(–navy) !important;
text-decoration: underline;
font-size: 13px;
padding: 6px !important;
}
.unlock-fineprint {
text-align: center;
color: var(–pencil);
font-size: 11px;
margin: 6px 0 0;
}

/* —– BUNDLE SCREEN —– */
.bundle-card {
background: white;
border: 1.5px solid var(–line);
border-radius: 18px;
overflow: hidden;
margin-bottom: 18px;
}
.bundle-grid {
display: grid;
grid-template-columns: repeat(5, 1fr);
gap: 0;
background: linear-gradient(135deg, var(–paper-warm), var(–powder));
padding: 22px 12px;
}
.bundle-grid-item {
text-align: center;
font-family: ‘EB Garamond’, serif;
font-style: italic;
font-weight: 800;
font-size: 22px;
color: var(–orange);
}
.bundle-summary {
padding: 16px 18px;
}
.bundle-line {
display: flex;
justify-content: space-between;
align-items: center;
padding: 6px 0;
font-size: 14px;
color: var(–ink-soft);
}
.bundle-line .strike {
text-decoration: line-through;
color: var(–pencil);
}
.bundle-total {
border-top: 1px dashed var(–line);
padding-top: 12px;
margin-top: 4px;
color: var(–ink);
font-weight: 700;
}
.bundle-total-price {
font-size: 20px;
color: var(–orange);
font-weight: 800;
}
.bundle-saves {
font-size: 12px;
text-transform: uppercase;
letter-spacing: 1.4px;
color: var(–orange);
font-weight: 800;
text-align: right;
margin-top: 4px;
}

/* —– PURCHASE SHEET (mock OS modal) —– */
.purchase-overlay {
position: fixed;
inset: 0;
background: rgba(0, 0, 0, 0.55);
z-index: 100;
display: flex;
align-items: flex-end;
justify-content: center;
backdrop-filter: blur(4px);
-webkit-backdrop-filter: blur(4px);
animation: fadeIn 0.2s ease-out;
}
/* Force hidden overlay to be invisible AND not intercept pointer events */
.purchase-overlay[hidden] {
display: none !important;
}
@keyframes fadeIn {
from { opacity: 0; }
to { opacity: 1; }
}
.purchase-sheet {
background: white;
width: 100%;
max-width: 540px;
border-radius: 18px 18px 0 0;
padding: 22px 22px 28px;
animation: slideUp 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
@keyframes slideUp {
from { transform: translateY(100%); }
to { transform: translateY(0); }
}
.purchase-header {
display: flex;
align-items: center;
gap: 14px;
padding-bottom: 18px;
border-bottom: 1px solid var(–line);
}
.purchase-app-icon {
width: 52px;
height: 52px;
border-radius: 14px;
background: linear-gradient(135deg, var(–orange), #d96a1a);
color: white;
display: flex;
align-items: center;
justify-content: center;
font-weight: 900;
font-size: 18px;
flex-shrink: 0;
}
.purchase-app-name {
font-weight: 700;
font-size: 15px;
color: var(–ink);
}
